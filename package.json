		"leaflet": "^1.9.4",
		"next": "16.1.5",
		"react": "19.1.5",
		"react-dom": "19.1.5",
		"react-leaflet": "^4.2.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/awesomplete": "^1.1.16",
		"@types/bootstrap": "^5.2.10",
		"@types/leaflet": "^1.9.12",
		"@types/node": "^20.19.30",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
